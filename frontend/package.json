{
  "name": "meshcore-chat-panel",
  "version": "0.3.2",
  "private": true,
  "description": "MeshCore sidebar panel for Home Assistant",
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:ts && rollup -c",
    "dev": "npm run build:ts && rollup -c --watch",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^8.0.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "happy-dom": "^21.0.4",
    "rollup": "^4.63.1",
    "tslib": "^2.6.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "browserslist": [
    "chrome >= 64",
    "edge >= 79",
    "firefox >= 67",
    "safari >= 12",
    "and_chr >= 64",
    "ios_saf >= 12",
    "samsung >= 9"
  ],
  "overrides": {
    "vite": "8.1.6",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "postcss": "8.5.23",
    "source-map-js": "1.2.2"
  }
}
